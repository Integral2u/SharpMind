<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>SharpMind.ico</ApplicationIcon>
    <PackageProjectUrl>https://github.com/Integral2u/SharpMind</PackageProjectUrl>
    <PackageIcon>Logo128.png</PackageIcon>
    <RepositoryType></RepositoryType>
    <PackAsTool>True</PackAsTool>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/Integral2u/SharpMind</RepositoryUrl>
    <PackageTags>LLM, Training, C#</PackageTags>
    <Version>0.9.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SharpMind.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\SharpMind\Logo128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMind.Core\SharpMind.Core.csproj" />
    <ProjectReference Include="..\SharpMind.Data\SharpMind.Data.csproj" />
    <ProjectReference Include="..\SharpMind.Model\SharpMind.Model.csproj" />
    <ProjectReference Include="..\SharpMind.Tokenization\SharpMind.Tokenization.csproj" />
  </ItemGroup>

</Project>

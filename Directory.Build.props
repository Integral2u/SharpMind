<Project>
  <PropertyGroup>
    <!-- Version: single place to bump for all packages -->
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- NuGet publishing defaults -->
    <Authors>SharpMind</Authors>
    <PackageProjectUrl>https://github.com/Integral2u/SharpMind</PackageProjectUrl>
    <PackageIcon>Logo128.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Integral2u/SharpMind</RepositoryUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(SolutionDir)nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\Logo128.png" Pack="True" PackagePath="\" />
  </ItemGroup>
</Project>

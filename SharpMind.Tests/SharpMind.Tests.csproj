<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>SharpMind.ico</ApplicationIcon>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Reference\**" />
  </ItemGroup>

  <!--
    Embeds a copy of SharpMind.Core.dll into the test assembly as two
    embedded-resource dependencies (libs.ProbeDep.dll and a dotted-stem name).
    This lets PluginAssemblyResolver tests exercise the embedded-resource
    resolution path against a real loadable assembly. SharpMind.Core builds
    first via the ProjectReference below, so its DLL exists by evaluation time.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\SharpMind.Core\bin\$(Configuration)\net10.0\SharpMind.Core.dll')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\SharpMind.Core\bin\$(Configuration)\net10.0\SharpMind.Core.dll" LogicalName="libs.ProbeDep.dll" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\SharpMind.Core\bin\$(Configuration)\net10.0\SharpMind.Core.dll" LogicalName="libs.Newtonsoft.Json.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SharpMind.ico" />
    <Content Include="DataRef\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMind.Core\SharpMind.Core.csproj" />
    <ProjectReference Include="..\SharpMind.CUI\SharpMind.CUI.csproj" />
    <ProjectReference Include="..\SharpMind.Data\SharpMind.Data.csproj" />
    <ProjectReference Include="..\SharpMind.Extensions.AI\SharpMind.Extensions.AI.csproj" />
    <ProjectReference Include="..\SharpMind.GPU\SharpMind.GPU.csproj" />
    <ProjectReference Include="..\SharpMind.Inference\SharpMind.Inference.csproj" />
    <ProjectReference Include="..\SharpMind.Model\SharpMind.Model.csproj" />
    <ProjectReference Include="..\SharpMind.Samples\SharpMind.Samples.csproj" />
    <ProjectReference Include="..\SharpMind.Training\SharpMind.Training.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="GPU\" />
  </ItemGroup>

</Project>

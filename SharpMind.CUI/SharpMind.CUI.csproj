<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SharpMind.CUI</RootNamespace>
    <AssemblyName>SharpMind.CUI</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!--
    Intentionally zero PackageReference entries. This project talks to
    System.Console directly and does its own screen-buffer diffing rather
    than pulling in a terminal UI library — see Screen/ScreenBuffer.cs.
    The only ItemGroup below is project references to the engine itself.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SharpMind.GPU\SharpMind.GPU.csproj" />
    <ProjectReference Include="..\SharpMind\SharpMind.csproj" />
    <ProjectReference Include="..\SharpMind.Core\SharpMind.Core.csproj" />
    <ProjectReference Include="..\SharpMind.Model\SharpMind.Model.csproj" />
    <ProjectReference Include="..\SharpMind.Tokenization\SharpMind.Tokenization.csproj" />
    <ProjectReference Include="..\SharpMind.Inference\SharpMind.Inference.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SharpMind.CUI</RootNamespace>
    <AssemblyName>SharpMind.CUI</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>SharpMind.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SharpMind.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpMind.Core\SharpMind.Core.csproj" />
    <ProjectReference Include="..\SharpMind.Data\SharpMind.Data.csproj" />
    <ProjectReference Include="..\SharpMind.Model\SharpMind.Model.csproj" />
    <ProjectReference Include="..\SharpMind.Tokenization\SharpMind.Tokenization.csproj" />
    <ProjectReference Include="..\SharpMind.Training\SharpMind.Training.csproj" />
    <ProjectReference Include="..\SharpMind.Inference\SharpMind.Inference.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Plugins\Readme.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Plugins\SharpMind.Extensions.Tools.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpMind.Tests" />
  </ItemGroup>

  <!-- Build-order only: ReferenceOutputAssembly="false" keeps SharpMind.GPU out of the CUI's
       compile-time reference set (issue #13 - no accelerator assembly in the main line) while
       still guaranteeing it is built before the copy below runs. -->
  <ItemGroup>
    <ProjectReference Include="..\SharpMind.GPU\SharpMind.GPU.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyAcceleratorPlugin" AfterTargets="Build">
    <ItemGroup>
      <!-- The plugin plus its own dependencies only. The host's assemblies are already
           loaded; a second copy beside the plugin would give the loader a duplicate
           SharpMind.Core to bind against. -->
      <AcceleratorPluginFiles Include="$(MSBuildThisFileDirectory)..\SharpMind.GPU\bin\$(Configuration)\$(TargetFramework)\*.dll"
                              Exclude="$(MSBuildThisFileDirectory)..\SharpMind.GPU\bin\$(Configuration)\$(TargetFramework)\SharpMind.Core.dll;
                                       $(MSBuildThisFileDirectory)..\SharpMind.GPU\bin\$(Configuration)\$(TargetFramework)\SharpMind.Model.dll;
                                       $(MSBuildThisFileDirectory)..\SharpMind.GPU\bin\$(Configuration)\$(TargetFramework)\SharpMind.Training.dll;
                                       $(MSBuildThisFileDirectory)..\SharpMind.GPU\bin\$(Configuration)\$(TargetFramework)\SharpMind.Data.dll;
                                       $(MSBuildThisFileDirectory)..\SharpMind.GPU\bin\$(Configuration)\$(TargetFramework)\SharpMind.Tokenization.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AcceleratorPluginFiles)"
          DestinationFolder="$(OutputPath)Plugins\cuda\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

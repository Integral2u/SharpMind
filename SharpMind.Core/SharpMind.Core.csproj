<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Description>Zero-dependency tensor primitives and math ops for SharpMind.</Description>
		<Optimize>true</Optimize>
		<ApplicationIcon>SharpMind.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="SharpMind.ico" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="JigSawDotNet" Version="1.0.8" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SharpMind\SharpMind.csproj" />
	</ItemGroup>

</Project>
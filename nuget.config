<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-wide NuGet sources. The local feed used during development is intentionally
  NOT listed here: an unconditional <add> pointing at a missing folder breaks
  restore on machines that don't have it. To use a private feed, add it to the
  user-level config instead:
      %AppData%\NuGet\NuGet.Config   (Windows)
      ~/.nuget/NuGet/NuGet.Config    (Linux/macOS)
  e.g.  <add key="local" value="path\to\local-packages" />
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

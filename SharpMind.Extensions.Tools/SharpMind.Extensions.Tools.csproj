<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Optional common tools (grep, git, datetime) for SharpMind's agent layer. Drop into the plugins folder to auto-discover.</Description>
    <PackageTags>LLM; C#; AI; Tools; SharpMind</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMind.Core\SharpMind.Core.csproj" />
  </ItemGroup>

  <!-- After build, copy the output DLL to the SharpMind.CUI plugins folder so it's auto-discovered at runtime. -->
  <Target Name="CopyToolsToCuiPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="..\SharpMind.CUI\Plugins"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
